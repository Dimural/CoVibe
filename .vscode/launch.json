{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Extension (Window A)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/extension"]
