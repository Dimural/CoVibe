{
  "name": "@covibes/extension",
  "displayName": "CoVibes",
  "description": "Real-time collaborative AI-assisted coding sessions",
  "version": "0.0.1",
  "publisher": "covibes",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "covibes.focusSessionPanel",
        "title": "CoVibes: Focus Session Panel"
      },
      {
        "command": "covibes.startSession",
        "title": "CoVibes: Start Session"
      },
      {
        "command": "covibes.joinSession",
        "title": "CoVibes: Join Session"
      },
      {
        "command": "covibes.leaveSession",
        "title": "CoVibes: Leave Session"
      }
    ],
    "configuration": {
      "title": "CoVibes",
      "properties": {
        "covibes.relayUrl": {
          "type": "string",
          "default": "wss://covibes-relay.fly.dev",
          "description": "WebSocket URL of the CoVibes relay server"
        },
        "covibes.followMode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable follow mode (auto-scroll to followed participant's cursor)"
        },
        "covibes.agentDetection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable heuristic AI agent detection"
        },
        "covibes.agentDetection.minEditsPerSecond": {
          "type": "number",
          "default": 3,
          "description": "Minimum edits per second to classify a burst as agent-like"
        },
        "covibes.agentDetection.minInsertionChars": {
          "type": "number",
          "default": 200,
          "description": "Minimum characters inserted in a single edit to classify as agent-like"
        },
        "covibes.agentDetection.minAffectedLines": {
          "type": "number",
          "default": 5,
          "description": "Minimum lines affected by a single edit to classify as agent-like"
        },
        "covibes.agentDetection.terminalPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Claude*",
            "Aider*",
            "Cursor*",
            "GitHub Copilot*",
            "Copilot*",
            "Devin*",
            "Cody*"
          ],
          "description": "Glob patterns matched against terminal names to identify agent terminals"
        },
        "covibes.gracePeriodSeconds": {
          "type": "number",
          "default": 1800,
          "description": "Seconds to keep a session open after the last participant disconnects"
        },
        "covibes.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Send anonymous usage statistics to help improve CoVibes. No code, file paths, or personal data is ever collected. See PRIVACY.md for details."
        }
      }
    },
    "virtualDocuments": [
      {
        "viewType": "covibes-conflict",
        "displayName": "CoVibes Conflict Resolution",
        "selector": [
          {
            "scheme": "covibes-conflict"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.24.0",
    "fast-check": "^3.22.0",
    "simple-git": "^3.36.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@covibes/protocol": "workspace:*",
    "diff-match-patch": "^1.0.5",
    "ws": "^8.18.0"
  }
}
